<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>Sezika.Cuda</AssemblyName>
    <RootNamespace>Sezika.Cuda</RootNamespace>
    <Description>CUDA Driver prototype backend for Sezika.</Description>
    <IsPackable>false</IsPackable>
    <IsAotCompatible>true</IsAotCompatible>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <EnableAotAnalyzer>true</EnableAotAnalyzer>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Sezika\Sezika.csproj" />
  </ItemGroup>
</Project>
